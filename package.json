{
  "name": "drama-queen",
  "private": true,
  "version": "3.7.3-rc-fix-control.0",
  "type": "module",
  "scripts": {
    "generate-routes": "tsr generate",
    "dev": "pnpm run generate-routes && vite --port 5001 --strictPort",
    "test": "vitest run",
    "check": "tsc",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "build": "tsc && pnpm run generate-routes && vite build",
    "serve": "vite serve --port 5001 --strictPort",
    "postbuild": "node build/remote-env.cjs remoteEntry.js",
    "preview": "vite preview --port 5001 --strictPort",
    "_format": "prettier --ignore-unknown .",
    "format": "npm run _format -- --write",
    "format:check": "npm run _format -- --list-different",
    "lint": "eslint ./src",
    "stop": "kill-port --port 5000,5001,5002",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@inseefr/lunatic": "^3.13.5-rc-fix-controls.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^7.29.4",
    "@tanstack/history": "^1.162.4",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@types/memoizee": "^0.4.12",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "evt": "^2.5.9",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "oidc-spa": "6.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-hot-keys": "^3.0.0",
    "react-i18next": "^17.0.15",
    "redux-clean-architecture": "^4.3.2",
    "tsafe": "^1.8.12",
    "tss-react": "^4.9.21",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "kill-port": "^2.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vite-envs": "^4.7.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --list-different"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": "prettier --write --ignore-unknown --list-different"
  }
}
